{
    "compilerOptions": {
        "target": "es2024",
        "module": "commonjs",
        "types": [
            "node"
        ],
        "typeRoots": [
            "src/@types",
            "node_modules/@types",
            "@types"
        ],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strictPropertyInitialization": false,
        "resolveJsonModule": true
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules"
    ]
}